# 复制成 .env 后填入真实值（.env 已在 .gitignore 里，不会入库）
#   cp .env.example .env
# 命令行里显式 export 的变量优先，这个文件只做兜底。

# ---- 发信（必填）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱@qq.com
# 注意：这里是 16 位「SMTP 授权码」，不是登录密码。
# 获取：邮箱网页版 → 设置 → 账户 → 开启 IMAP/SMTP 服务 → 短信验证 → 得到授权码
SMTP_PASS=
MAIL_FROM=
MAIL_TO=frankqiu2020@foxmail.com

# ---- COS 备份（可选，不填就只发政务网直链）----
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-shanghai
# COS_BUCKET=huzhou-epi
# COS_APPID=
